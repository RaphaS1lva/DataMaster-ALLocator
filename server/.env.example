# Copie para `server/.env` e preencha. O .env está no .gitignore e NUNCA deve
# ser commitado. Guia completo: docs/09-runbook-notebook.md
#
# Gerar um segredo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---------------------------------------------------------------------------
# BANCO - Neon (https://neon.tech). Obrigatório para as rotas /dados/*.
# Sem isto, a API roda só a inferência e o portal cai no modo local
# (localStorage), que é demonstrável mas não persiste entre máquinas.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.us-east-2.aws.neon.tech/allocator?sslmode=require

# ---------------------------------------------------------------------------
# AUTENTICAÇÃO
# ---------------------------------------------------------------------------
# Assina os JWT de sessão. Trocar invalida todas as sessões.
JWT_SECRET=

# Bearer compartilhado que o portal usa para chamar a API. Na v1 a API era
# completamente aberta (CORS `*`, sem token): quem descobrisse a URL podia
# queimar a cota de LLM do projeto.
ALLOCATOR_API_TOKEN=

# Origens permitidas, separadas por vírgula. Inclua o domínio do GitHub Pages.
# Vazio = só localhost (padrão de desenvolvimento).
ALLOWED_ORIGINS=https://SEUUSUARIO.github.io,http://localhost:5173

# ---------------------------------------------------------------------------
# INFERÊNCIA LOCAL - Ollama
# ---------------------------------------------------------------------------
# Onde o Ollama escuta. Se a API roda na mesma máquina, o padrão serve.
OLLAMA_URL=http://127.0.0.1:11434

# ---------------------------------------------------------------------------
# FALLBACK DE NUVEM - opcional
#
# Só é usado quando o Ollama local está fora. ATENÇÃO: os termos dos tiers
# gratuitos destes provedores permitem uso dos dados para treinamento. Se o
# documento contiver balanço de empresa fechada, deixe estas chaves VAZIAS para
# garantir que nada saia da máquina - o modo determinístico continua
# funcionando. Ver docs/08-seguranca-guardrails.md.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# LIMITES
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=40

# Barra arquivo absurdo antes de gastar CPU na extração de palavras. 400 cobre o
# DFP anual de companhia aberta, que tem rotineiramente 130 a 300 páginas - o
# valor antigo (120) foi calibrado contra ITR trimestral e recusava o caso
# principal. Página excedente custa TEMPO, não erro: o gate de demonstração já
# descarta o que não é Balanço nem DRE.
MAX_PAGINAS=400
LOG_LEVEL=INFO
